{
  "schemas": [
    {
      "id": "book-schema",
      "name": "Book",
      "enabled": true,
      "where": "file.hasTag(\"book\") || file.inFolder(\"Books\")",
      "fields": [
        { "name": "title", "type": "string", "required": true },
        { "name": "author", "type": "string", "required": true },
        { "name": "rating", "type": "number", "required": false, "must": "it <= 5" },
        { "name": "isbn", "type": "string", "required": false, "unique": true }
      ]
    }
  ],
  "types": [],
  "unknownFields": true,
  "openFields": ["aliases", "tags", "cssclasses", "cssclass"]
}
