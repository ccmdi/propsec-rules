{
  "name": "@propsec/core",
  "version": "0.1.0",
  "description": "Typed, queryable frontmatter rules for Markdown.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccmdi/propsec-rules.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/parity"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
